<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Deep olive ground, lit from the top left. -->
    <path android:pathData="M0,0 L108,0 L108,108 L0,108 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108">
                <item android:offset="0" android:color="#5C7A3C"/>
                <item android:offset="0.55" android:color="#3F5A28"/>
                <item android:offset="1" android:color="#233316"/>
            </gradient>
        </aapt:attr>
    </path>
    <!-- Soft light pooling behind the book. -->
    <path android:pathData="M0,0 L108,0 L108,108 L0,108 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="44"
                android:centerY="40"
                android:gradientRadius="58">
                <item android:offset="0" android:color="#2EFFFFFF"/>
                <item android:offset="0.6" android:color="#0AFFFFFF"/>
                <item android:offset="1" android:color="#00FFFFFF"/>
            </gradient>
        </aapt:attr>
    </path>
</vector>
