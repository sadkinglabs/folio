    <!-- Setting the e-reader up over SSH (PluginSetupSheet.kt) -->
    <string name="m9sync_setup_title">Set up your e-reader</string>
    <string name="m9sync_setup_reinstall_title">Reinstall the Librillo plugin</string>
    <string name="m9sync_setup_intro">Librillo puts its plugin on your e-reader over Wi-Fi. You only do this once. Keep both on the same Wi-Fi.</string>
    <string name="m9sync_setup_step_ssh">Turn on SSH in KOReader</string>
    <string name="m9sync_setup_step_ssh_body">On the e-reader, open KOReader\'s top menu, then the gear tab → Network → SSH server. Turn on Login without password, then start the SSH server. It shows the e-reader\'s address.</string>
    <string name="m9sync_setup_step_find">Find the e-reader</string>
    <string name="m9sync_setup_find">Find it</string>
    <string name="m9sync_setup_found">Found the e-reader at %1$s.</string>
    <string name="m9sync_setup_key">Key: %1$s</string>
    <string name="m9sync_setup_key_changed">This isn\'t the key Librillo saw last time. Go on only if you reset or replaced the e-reader.</string>
    <string name="m9sync_setup_step_folder">Name the library folder</string>
    <string name="m9sync_setup_folder_label">Folder on the e-reader</string>
    <string name="m9sync_setup_folder_hint">Your books go in this folder, by author.</string>
    <string name="m9sync_setup_folder_invalid">Use a plain folder name, like Librillo.</string>
    <string name="m9sync_setup_install">Install</string>
    <string name="m9sync_setup_installing">Installing…</string>
    <string name="m9sync_setup_done">The plugin is on your e-reader. Three steps there:</string>
    <string name="m9sync_setup_done_restart">Restart KOReader. If it says to, restart it once more.</string>
    <string name="m9sync_setup_done_sync">Tap Librillo → Sync now.</string>
    <string name="m9sync_setup_done_ssh_off">Turn KOReader\'s SSH server off: gear tab → Network → SSH server.</string>
