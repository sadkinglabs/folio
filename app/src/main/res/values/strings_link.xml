    <string name="hardcover_automatic">Update Hardcover automatically</string>
    <string name="hardcover_automatic_hint">Sends your reading position from this phone and from your e-reader about a minute after you stop reading. Only moves forward, and only for books already marked Currently Reading on Hardcover.</string>

