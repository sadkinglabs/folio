    <!-- Shell: detach an EPUB from its book entry -->
    <string name="shell_detach_title">Detach this EPUB?</string>
    <string name="shell_detach_body">The EPUB keeps its notes, progress and place on your e-reader. The book it was attached to becomes a separate entry again, with its details, Hardcover match and lists, ready for the right EPUB.</string>
    <string name="shell_detach">Detach</string>
    <string name="shell_keep_attached">Keep attached</string>

