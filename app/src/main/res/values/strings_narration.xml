    <string name="listen_test">Test read-aloud speed</string>
    <string name="listen_test_body">Reads a sample passage, not your book, with each setting and measures how fast this phone makes speech.</string>
    <string name="listen_test_duration">Takes about %1$d min.</string>
    <string name="listen_test_minutes">Sustained run: %1$d min</string>
    <string name="listen_test_start">Start test</string>
    <string name="listen_test_again">Test again</string>
    <string name="listen_test_running">Testing… step %1$d of %2$d</string>
    <string name="listen_test_step_load">Loading the voice</string>
    <string name="listen_test_step_sweep">Trying each setting</string>
    <string name="listen_test_step_diagnostic">Measuring the pauses between sentences</string>
    <string name="listen_test_step_sustained">Long run</string>
    <string name="listen_test_step_result">Saving the results</string>
    <string name="listen_test_screen_off">You can turn the screen off now.</string>
    <string name="listen_test_cancel">Stop test</string>
