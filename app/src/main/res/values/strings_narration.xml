<?xml version="1.0" encoding="utf-8"?>
<!-- Read-aloud with the natural voice: preparation, the too-slow choices and the speed test. -->
<!-- Thread counts are always 2 to 6, so "threads" needs no plural form. -->
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Listen bar, while narration is being prepared -->
    <string name="listen_preparing">Preparing narration…</string>
    <string name="listen_preparing_eta">Preparing narration… about %1$d s</string>
    <string name="listen_chapter_progress">Preparing chapter… %1$d%%</string>

    <!-- Listening sheet -->
    <string name="listen_ready_ahead">Ready ahead: %1$d s</string>
    <string name="listen_pace">Makes speech %1$s× faster than it reads</string>
    <string name="listen_pace_slow">Makes speech at %1$s× its reading speed</string>
    <string name="listen_variant">Natural voice model</string>
    <string name="listen_variant_standard">Standard</string>
    <string name="listen_variant_faster">Faster (larger download)</string>
    <!-- The faster model's name in the speed test's results -->
    <string name="listen_variant_faster_name">Faster</string>
    <string name="listen_record">Record read-aloud measurements</string>
    <string name="listen_record_share">Share last measurements</string>
    <string name="listen_share_failed">The files could not be prepared for sharing.</string>

