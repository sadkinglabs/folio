    <string name="listen_slow_title">This phone can\'t make the natural voice fast enough</string>
    <string name="listen_slow_body">It makes speech at %1$s× the speed it reads, so reading would keep stopping.</string>
    <string name="listen_slow_prepare">Prepare this chapter first (about %1$d min)</string>
